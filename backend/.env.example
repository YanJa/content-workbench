# ==================== 内容运营工作台 · 环境变量 ====================
# 复制为 .env 后填写。切勿把 .env 提交到版本库。

# ---------- 基础 ----------
APP_ENV=dev
DEBUG=true
API_PREFIX=/api
# 前端地址（CORS 白名单，逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 认证（用户模块） ----------
# JWT 签名密钥。**公网部署必须填**（用 `openssl rand -hex 32` 生成）。
# 留空时首次启动自动生成并持久化到 data/secret.key（权限 0600）。
# 注意：换了它，所有已登录用户的 token 与所有已签发的静态直链会同时失效。
JWT_SECRET=
# token 有效期（小时），默认 168 = 7 天
JWT_TTL_HOURS=168
# 注册通道：invite=需邀请码（推荐）| open=自由注册 | closed=关闭注册
# 无论哪种模式，第一个注册的用户都免邀请码，并自动认领库里的存量数据
AUTH_REGISTER_MODE=invite
# AUTH_REGISTER_MODE=invite 时的邀请码
INVITE_CODE=

# ---------- 数据库 ----------
# 一期用 SQLite，零配置。数据文件在 backend/data/workbench.db
DATABASE_URL=sqlite+aiosqlite:///./data/workbench.db
# 切换到 PostgreSQL 时改成（记得同时装 asyncpg）：
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/workbench

# ---------- Redis ----------
# 留空则自动使用内存缓存（本地开发无需装 Redis）
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# ---------- 大模型（必填） ----------
# 申请地址：https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 当前主力模型（V4.1-Flash，1M 上下文，原生视觉，价格最低）
DEEPSEEK_MODEL_FLASH=deepseek-flash
# 旗舰模型（复杂策划时使用）
DEEPSEEK_MODEL_PRO=deepseek-v4-pro

# 兜底模型（可选）：DeepSeek 服务波动时自动切换
# 支持任何 OpenAI 兼容接口，如通义千问、豆包
FALLBACK_API_KEY=
FALLBACK_BASE_URL=
FALLBACK_MODEL=

# 生成参数
LLM_TEMPERATURE=0.8
LLM_MAX_TOKENS=4096
# httpx 单次读写超时（秒）。注意：它对"边想边吐"的推理模型几乎不生效，
# 卡总时长要用下面的 HUMANIZE_TIMEOUT。
LLM_TIMEOUT=120
# 「加人工痕迹」单次改写的墙钟总时长上限（秒）。超时即中止并报错，
# 不会让前端进度条永远停在 55%。实测千字稿约 130~150 秒。
HUMANIZE_TIMEOUT=300

# 峰谷提醒：DeepSeek 工作日高峰时段价格翻倍
# 高峰 = 北京时间 09:00-12:00 和 14:00-18:00
# 开启后在这些时段调用会打警告日志，便于发现可优化的批量任务
ENABLE_PEAK_GUARD=false

# ---------- 会话 ----------
# 保留最近 N 轮原文（其余压缩为摘要）
CONTEXT_WINDOW_TURNS=10
# 超过这个轮数触发摘要压缩
CONTEXT_SUMMARY_THRESHOLD=16

# ---------- 工具调用 ----------
ENABLE_TOOLS=true
# 需要人工确认才能执行的工具（逗号分隔）
# 这些操作会影响外部系统，不允许模型直接触发
TOOL_REQUIRE_CONFIRM=push_wechat_draft,render_video

# ---------- 微信公众号（推送草稿箱用） ----------
# 获取路径：公众平台 → 设置与开发 → 基本配置
# 说明：也可以不改这里，直接在「系统状态」页「添加公众号」管理（支持多个号 + 选默认）。
#      这里留空时，推送会用设置页配的默认号；两处都空则无法推送。
WECHAT_APPID=
WECHAT_SECRET=
# ⚠️ 必须把「服务器出网 IP」加入公众号后台的「API IP 白名单」，否则推送报 40164。
#   注意是出网 IP（curl -s https://api.ipify.org 查），不是 SSH 隧道服务器的 IP；
#   沙箱/云主机出网 IP 可能是动态的，长期稳定需固定出口 IP。
#
# —— 动态出网 IP 的解法：固定出口代理 ——
# 沙箱出网是动态池（一次能探到 20+ 个 IP），无法逐个加白。做法：让**仅微信请求**
# 走一台固定公网 IP 的机器出网（经 SSH -D 建的 SOCKS5，见 deploy/proxy-guard.sh）。
# 起隧道：setsid ./deploy/proxy-guard.sh > /tmp/proxy-guard.log 2>&1 &
# 然后打开下面两行，并把 WECHAT_PROXY_EXPECT_IP 填进公众号后台白名单。
# 留空 = 直连（原行为）。
WECHAT_PROXY=
WECHAT_PROXY_EXPECT_IP=

# ---------- 文件 ----------
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
MAX_UPLOAD_MB=50

# ---------- 素材库 ----------
# 存储后端：local（本地磁盘）/ s3（火山 TOS 对象存储）。
# 切 s3 后，素材与排版配图都直出 TOS，浏览器直连 TOS 公网 URL，
# 把图片流量从 ECS 带宽剥离（1M 小带宽尤其需要）。数据库只记相对 key
# （storage_key），不记完整 URL —— 换后端不用迁数据。
STORAGE_BACKEND=local

# ---- 火山引擎 TOS（STORAGE_BACKEND=s3 时启用）----
# 凭证在 火山控制台 → 访问控制 → 密钥管理 创建/获取。只放 .env，绝不进代码/日志/git。
# 注意：TOS 的 SecretAccessKey 是 base64 形态的字符串，**原样填写即可，不要解码**。
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
# 桶名（控制台 → 对象存储 TOS → 桶列表）。同地域 ECS 从 TOS 取图走内网免费。
TOS_BUCKET=cwb
TOS_REGION=cn-beijing
# 浏览器加载用的公网桶域名（如 cwb.tos-cn-beijing.volces.com）。留空则按
# {bucket}.tos-{region}.volces.com 自动推导。
TOS_PUBLIC_DOMAIN=
# S3 接口端点（put/get/delete 走这里）。内网端点（tos-s3-{region}.ivolces.com）
# 同地域免费、更快；但若 ECS 连不通内网端点（如不在同一 VPC），改用公网端点。
# TOS_USE_INTERNAL=true 用内网，false 用公网（tos-s3-{region}.volces.com）。
TOS_ENDPOINT_INTERNAL=https://tos-s3-cn-beijing.ivolces.com
TOS_ENDPOINT_PUBLIC=https://tos-s3-cn-beijing.volces.com
TOS_USE_INTERNAL=true
# 对象是否设 public-read：true 时 url() 返回永久公网直链（无需预签名），
# 浏览器/微信直接拉。需桶未开启「阻止公开访问」（Block Public Access）。
TOS_ACL_PUBLIC=true

# 每个账号的素材容量上限（MB），默认 2GB
ASSET_QUOTA_MB=2048
# 单张素材的最大体积（MB）
ASSET_MAX_MB=20
# 从在线图源导入的每小时上限（条/账号）。
# 这条线对应 Pixabay 条款里的「禁止系统性批量下载」，正常写作用不满。
ASSET_IMPORT_PER_HOUR=60
# 图源请求超时（秒）
ASSET_SEARCH_TIMEOUT=20

# ---------- 在线图源 ----------
# Pixabay：https://pixabay.com/api/docs/ 免费申请，填 key 后搜图面板才会出现 Pixabay。
# 条款要求：下载自存、禁止永久热链、禁止系统性批量下载 —— 所以本项目只在「导入」时
# 真正下载，搜索结果只做候选展示，且缓存 24 小时。
PIXABAY_API_KEY=
# Openverse：https://api.openverse.org/v1/ 匿名即可用（100 次/天），
# 想要更高配额可申请 token 填这里。只搜 license_type=commercial 的图。
OPENVERSE_TOKEN=

# ---------- 火山引擎 / 小云雀（Pippit）----------
# 小云雀的开放 API 托管在火山引擎「视觉智能」下（Service=cv、Region=cn-north-1），
# 不是 xyq.jianying.com 那个网页端。开通步骤：
#   1. 注册火山引擎账号 → 控制台 → 访问控制 → 密钥管理，创建并下载 Access Key；
#   2. 控制台搜索「智能视觉」→ 找到「小云雀-智能生视频 Agent」→ 开通服务；
#   3. 把 AK / SK 填到下面两行，重启后端。
# 注意：开放 API 只有「智能生视频」和「营销成片」两条线，是**视频**不是图片。
# 网页端/App 的「AI 海报、换背景」没有开放接口。
VOLC_ACCESS_KEY=
VOLC_SECRET_KEY=
VOLC_REGION=cn-north-1
VOLC_TIMEOUT=30

# 生视频轮询：每 5 秒查一次，最长等 10 分钟。
# 超时不等于失败——任务还在服务端跑，可以拿 task_id 继续查，不必重新提交（重新提交换个额度）。
PIPPIT_POLL_INTERVAL=5
PIPPIT_TIMEOUT=600
# 成片下载体积上限（MB）。返回的链接只有 1 小时有效期，必须立刻转存，这个上限防拖死内存。
PIPPIT_MAX_MB=200

# ---------- 配图生图（本地脚本） ----------
# 留空 = 不启用自动生图（前端会禁用「生成配图」，仍可手动上传图片）
# 填脚本绝对路径后，后端以子进程方式调用：
#   python <IMAGE_SCRIPT> --prompt <提示词> --size <尺寸> --count <张数> --out <输出目录>
# 后端取「调用前后新增的文件」当产物，文件名也可从 stdout 兜底解析。
# 接入自备脚本前，请确认它认识上面这套 CLI 参数，否则改 services/imagegen.py。
IMAGE_SCRIPT=
# 生图脚本单次超时（秒）
IMAGE_SCRIPT_TIMEOUT=180
# 默认出图尺寸（未显式指定 size 时用）
IMAGE_SIZE=1024x1024

# ---------- 文内配图：Cloudflare Workers AI 文生图（外部 API 通道） ----------
# 与上面的本地脚本通道二选一（也可都配，前端下拉里手动选）。
# 凭证获取：Cloudflare Dashboard → 右上头像 → My Profile → API Tokens
#   → Create Token → 选「Workers AI」模板（或自定义 token 勾选
#   Account.Workers AI:Read）→ 创建后复制（只显示一次）。
# ACCOUNT_ID 获取：Dashboard → 左侧 Workers & Pages → 右侧账号卡片可见，
#   或任意 Worker 详情页 URL 里的 accounts/<account_id>。
# 两项都填 = 前端「AI 生成」里出现 Cloudflare 选项；留空 = 该通道不可用。
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# 文生图模型（Workers AI 模型 id）。默认 flux-1-schnell 快且免费额度够日常用。
# 备选：@cf/black-forest-labs/flux-1-schnell（默认）/ @cf/stabilityai/stable-diffusion-xl-base-1.0
# 可用模型列表：https://developers.cloudflare.com/workers-ai/models/#text-to-image
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# 单次请求超时（秒）。Workers AI 排队 + 出图通常 10~40s，给足 2 分钟。
CLOUDFLARE_IMAGE_TIMEOUT=120
# 可选：让 Cloudflare 请求也走固定出口代理（形如 socks5://127.0.0.1:10800，
# 复用 deploy/proxy-guard.sh 的 SSH 隧道）。留空 = 直连，一般不用动。
CLOUDFLARE_PROXY=
# ---------- AI 对话（设置页「AI 对话」切到 Cloudflare 时用） ----------
# 用户在设置页选的模型优先，这里只是「没选过」时的兜底。
# 注意：CF 模型不支持对话内工具调用（查队列/推草稿箱等），流式不带 token 用量
# （用量页按估价展示）。备选：@cf/qwen/qwen1.5-14b-chat-awq 等。
CLOUDFLARE_CHAT_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# ---------- 知识库（RAG）：给 AI 写稿用的私有素材库 ----------
# 文本向量化模型。⚠️ 别换成 bge-*-en-v1.5 那些英文模型：对中文素材基本失效，
# bge-m3 是多语言模型，中文可用的唯一选择（1024 维）。
CLOUDFLARE_EMBED_MODEL=@cf/baai/bge-m3
# 片段长度/重叠（中文按字符计）、每次批量调用条数
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=60
KB_EMBED_BATCH=32
# 检索返回条数与最低相似度（低于阈值视为没命中，不注入上下文）
KB_TOP_K=5
KB_MIN_SCORE=0.45
# 关键词降级（向量化不可用时的兜底检索）要求至少命中几个二字组（1=宽松，2=严格）
KB_MIN_KEYWORD_HITS=1
# 注入上下文的素材总字数硬顶（CF 通道的 8b 模型上下文小，单独给更小预算）
KB_MAX_CHARS=3000
KB_MAX_CHARS_CF=1200
# 每人素材条数 / 片段总数上限
KB_MAX_ITEMS_PER_USER=300
KB_MAX_CHUNKS_PER_USER=3000

# ---------- 知乎数据开放平台（对话灵感卡片的数据源） ----------
# 获取：https://developer.zhihu.com/profile → 登录知乎账号 → 「申请新 Access Secret」
#
# ⚠️ 安全提醒（务必看一眼再填）：
#   1. Access Secret 持有该账号的**完整 API 权限**，等同于可操作你知乎账号；
#   2. 同一账号下所有 Secret **共享同一额度池**，开放平台的页面效果测试也扣这个池；
#   3. 所以：只写在这个文件里（已在 .gitignore 覆盖），绝不进前端、日志或代码。
#
# 填了就会：每 30 分钟自动抓一次热榜存档，对话页「不知道写啥」时给热点灵感。
ZHIHU_ACCESS_SECRET=
# 抓取间隔（分钟）。30 分钟 = 48 次/天（每日免费池 100 次），余量留给实时查询。
ZHIHU_HOT_INTERVAL_MINUTES=30
# 单次抓多少条（平台硬上限 30）
ZHIHU_HOT_LIMIT=30
# 单次请求超时（秒）
ZHIHU_TIMEOUT=15
# 每日额度水位保护：当天已用 >= _QUOTA_SAFETY 次后自动跳过抓取，防止烧穿
ZHIHU_DAILY_QUOTA=100
ZHIHU_QUOTA_SAFETY=88
# 屏蔽词（逗号分隔）：命中的热榜条目不入库也不展示。
# 热榜常有时政/社会争议类，按你自己账号的调性决定要不要过滤。留空=不过滤。
ZHIHU_BLOCK_KEYWORDS=
# 可选：固定出口代理（形如 socks5://127.0.0.1:10800）。一般不需要。
ZHIHU_PROXY=

# ---------- 封面图（模板化，与上面的 AI 生图是两条独立通道） ----------
# 封面走「HTML 模板 + 无头浏览器截图」，文字确定、品牌统一，出的是头图/封面。
# 默认指向项目自带的脚本（相对路径按 backend/ 解析），留空则关闭封面通道
# （前端「生成封面」禁用，排版也不再自动带封面）。
COVER_SCRIPT=scripts/make-cover.py
# 渲染超时（秒）。纯本地截图，很快。
COVER_TIMEOUT=60
# 封面左上角默认标签，如「码上聊聊 · 效率指南」。留空 = 不带标签。
COVER_TAG=
# 默认风格 gradient(渐变) / dark(深色) / light(浅色)
COVER_STYLE=gradient
# 默认尺寸 wide(900x383 公众号头条) / square(800x800) / og(1200x630)
COVER_SIZE=wide

# ---------- 声音复刻 ----------
# 录音与音色库目录（每个音色一个子目录：参考音频 + voice.json）
VOICE_DIR=./data/voices
# 复刻后端，三选一：
#   edge  = 不复刻，用 edge-tts 官方音色（默认，零依赖）
#   xtts  = 本地 Coqui XTTS-v2 零样本克隆（零成本、不联网，需 pip install coqui-tts）
#   cloud = 云端声音复刻 API（效果最好，需下面三项）
VC_PROVIDER=edge
# 云端复刻（阿里云 CosyVoice / MiniMax / 火山方舟等 OpenAI 风格端点）
# 约定接口：POST {BASE}/voice/clone 建音色、POST {BASE}/audio/speech 合成
VC_CLOUD_BASE_URL=
VC_CLOUD_API_KEY=
VC_CLOUD_MODEL=cosyvoice-v1
# 录音大小上限（MB）。样本只需 10~30 秒，20MB 足够宽容
MAX_VOICE_UPLOAD_MB=20

# ==================== 国内源（可选，但强烈建议） ====================
# 这些是给 uv / pip 安装依赖用的，写在这里只是备忘，
# 实际生效位置是 uv 的 --index-url 参数或 ~/.config/uv/uv.toml
# 清华源:   https://pypi.tuna.tsinghua.edu.cn/simple
# 阿里云:   https://mirrors.aliyun.com/pypi/simple/
# 腾讯云:   https://mirrors.cloud.tencent.com/pypi/simple/
