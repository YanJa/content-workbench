# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Node
node_modules/
dist/

# 运行时数据与敏感配置（sqlite 库、JWT secret、API key、上传产物）
# data/ 匹配任意层级 —— security.py 写的是相对路径 ./data/secret.key，
# 从哪个目录误启动 uvicorn 就会在哪落一个，必须全层级拦住
# （2026-10-19：曾因在 frontend/ 下误跑后端，把 secret.key 带进 git）
data/
.env
backend/.env

# Makefile 的本地部署配置：里面有真实服务器 IP / 登录用户 / 密钥路径，
# 由 make init 生成，绝不进公开仓库（与「运营主体信息不入库」同一条约定）
.env.deploy

# 日志与系统文件
*.log
.DS_Store
