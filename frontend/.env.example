# 前端环境变量（Vite 约定：必须以 VITE_ 开头）
# 开发期留空即可，vite.config.ts 已配好 /api 代理到后端
VITE_API_BASE=/api

# 允许访问 dev server 的 Host（逗号分隔）。默认只放本机；
# 经隧道/公网域名调试时，把那个域名写进自己机器的 .env，别写进仓库。
VITE_ALLOWED_HOSTS=localhost,127.0.0.1

# ICP 备案号（仅中国大陆境内公网部署需要）
# 备案号是站点运营主体的私有信息，不要提交进仓库；本文件是模板，
# 复制成 .env 后填真值（.env 已被 .gitignore 忽略）。
# 留空 = 不渲染页脚；本地开发与境外部署保持留空即可。
# 示例格式：VITE_ICP_BEIAN=XICP备00000000号-1
VITE_ICP_BEIAN=
# 备案查询链接，一般不用改
VITE_ICP_BEIAN_URL=https://beian.miit.gov.cn

# 邀请注册文案里的直链。留空 = 用当前站点域名 + /register。
# 想让邀请文案固定指向某个公网域名时才填（同样不写进仓库）。
# VITE_INVITE_URL=https://your-domain.com/register
